# Powers the "Ask Nithish" chat. Without it the chat still works, using simple
# keyword answers taken from the page. Create a key at https://platform.claude.com
ANTHROPIC_API_KEY=

# Optional. Which Claude model answers. Defaults to claude-opus-5-5.
# ASK_MODEL=claude-haiku-5-5

# Guestbook. The Upstash Redis integration from the Vercel Marketplace sets the
# first two for you. The admin key is any long secret you choose; you type it
# at /guestbook/admin to approve notes.
KV_REST_API_URL=
KV_REST_API_TOKEN=
GUESTBOOK_ADMIN_KEY=
